# Tesla Fleet API application credentials (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your vehicles: name=VIN pairs, comma-separated
TTB_VEHICLES=Model Y=YOUR_VIN_HERE,Model 3=SECOND_VIN_HERE

# The OpenAI-compatible server THIS app exposes
TTB_SERVER_HOST=127.0.0.1
TTB_SERVER_PORT=8651
# Optional: require Authorization: Bearer <key> on /v1/* (recommended if exposed on LAN)
TTB_SERVER_API_KEY=
TTB_MODEL_ID=tesla-trip-brain

# Pluggable LLM backend — any OpenAI-compatible API. Default: local Ollama.
# The app works FULLY without a backend (rules engine); the LLM only explains
# the computed plan in free-form words. Vehicle data is sent only to
# this backend — nowhere else. This app never wakes or commands a car.
TTB_AI_BASE_URL=http://localhost:11434/v1
TTB_AI_API_KEY=
TTB_AI_MODEL=llama3.1
# auto = rules first, LLM for the rest | always = LLM first | never = rules only
TTB_AI_MODE=auto
TTB_AI_TIMEOUT_SECONDS=20

TTB_EMBEDDING_DIM=384
TTB_TOKEN_FILE=~/.ttb/tokens.json
# 1 = preview actions instead of performing them
TTB_DRY_RUN=0

# Trip-plan defaults — plain words, set by `ttrip setup`
TTB_PACK_KWH=75
TTB_RESERVE_PCT=10
TTB_CHARGER_KW=11.5
TTB_COLD_THRESHOLD_F=40
TTB_CALENDAR_FILE=~/.ttb/trips.ics
TTB_DATA_FILE=~/.ttb/trips.ics
